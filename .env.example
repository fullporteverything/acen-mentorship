# Discord OAuth App Credentials
# Create your app at: https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# NextAuth Secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Your deployment URL (no trailing slash)
# Local dev: http://localhost:3000
# Production: https://your-vercel-url.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Required: restrict login to members of this Discord guild
DISCORD_GUILD_ID=

# Required: role a guild member must have to sign in
DISCORD_REQUIRED_ROLE_ID=

# Discord user id of the admin (grants access to /dashboard/admin)
ADMIN_DISCORD_ID=
NEXT_PUBLIC_SUPPORT_URL=

# Channel the /support ticket bridge opens private threads in. Optional —
# falls back to the owner's #tickets channel when unset. Requires
# DISCORD_BOT_TOKEN with Create Private Threads + Send Messages there.
DISCORD_SUPPORT_CHANNEL_ID=

# Neon PostgreSQL. DATABASE_URL is the application connection. DATABASE_URL_TEST
# is never selected at production runtime; only an explicitly opted-in, non-production
# process (`DATABASE_USE_TEST_URL=true`) may use the isolated verification branch.
DATABASE_URL=
DATABASE_URL_TEST=
DATABASE_USE_TEST_URL=

# Kinescope video integration. All three values are server-only.
# Create the token in Kinescope Settings -> API, and copy the project and
# protected player IDs from the Kinescope dashboard.
KINESCOPE_API_TOKEN=
# Optional when the token can access exactly one project.
KINESCOPE_PROJECT_ID=
KINESCOPE_PLAYER_ID=

# Vercel Blob store ID (OIDC auth; from Vercel dashboard → Storage → Blob).
# Powers lesson progress, homework uploads, settings, and announcements.
# The app authenticates to Blob via OIDC and does NOT use a static
# BLOB_READ_WRITE_TOKEN — only the store ID is needed here.
BLOB_READ_WRITE_TOKEN_STORE_ID=

# ── Onboarding gate (NDA e-signature + Stripe Identity) ───────────────────────
# OFF by default. The gate ONLY engages when this is EXACTLY "true"; any other
# value (unset, "false", etc.) leaves /dashboard behaving exactly as before.
# Admins (ADMIN_DISCORD_ID) are never gated. Enabling this before wiring Stripe
# below still lets members through after signing the NDA (no dead end) — the
# identity step is only required once STRIPE_SECRET_KEY is present.
NDA_GATE_ENABLED=

# Stripe (TEST mode). Required only for the identity-verification step.
# Use a TEST secret key (sk_test_...). When absent, the NDA step alone gates.
STRIPE_SECRET_KEY=
# Signing secret for the Stripe Identity webhook (whsec_...). Required to accept
# webhook events — the webhook rejects anything it cannot verify with a 400.
# Configure the Stripe webhook endpoint to POST to:
#   {your-origin}/api/onboarding/identity/webhook
# subscribed to: identity.verification_session.verified,
#                identity.verification_session.requires_input,
#                identity.verification_session.canceled
STRIPE_WEBHOOK_SECRET=

# ── YouTube → Discord auto-announce ───────────────────────────────────────────
# Polls the channel's public RSS feed every ~5 min (see vercel.json cron) and
# posts each NEW long-form upload to a Discord channel with an @everyone ping.
# No YouTube API key needed. Dormant until all three below are set.
#
# Channel id (starts with "UC..."). Find it at youtube.com/account_advanced,
# or from any channel URL of the form youtube.com/channel/UC...
YOUTUBE_CHANNEL_ID=
# Discord channel id to post announcements into (right-click channel → Copy ID).
YOUTUBE_ANNOUNCE_CHANNEL_ID=
# Shared secret protecting /api/youtube/poll. Vercel Cron sends it automatically
# as "Authorization: Bearer <CRON_SECRET>"; an external cron can pass ?key=<it>.
# Use a long random string. The poll route refuses to run if this is unset.
CRON_SECRET=
# (Reuses DISCORD_BOT_TOKEN above to post — the bot must be able to send messages
#  and mention @everyone in the announcement channel.)
